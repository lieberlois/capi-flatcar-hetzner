# Template — rendered by scripts/08-apply-addons.sh.
# __HCLOUD_TOKEN_B64__ is replaced with the base64-encoded value of $HCLOUD_TOKEN.
# Sveltos copies the rendered data into each matching workload cluster.
#
# The hcloud-cloud-controller-manager chart reads the token from a Secret named
# "hcloud", key "token" (hardcoded in the chart's default env), in kube-system.
apiVersion: v1
kind: ConfigMap
metadata:
  name: hcloud-ccm-addon
  namespace: default
data:
  credentials.yaml: |
    apiVersion: v1
    kind: Secret
    metadata:
      name: hcloud
      namespace: kube-system
    type: Opaque
    data:
      token: __HCLOUD_TOKEN_B64__
